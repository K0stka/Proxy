{
  "name": "proxy-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "node scripts/dev.js",
    "preview:mock": "npm run build && node scripts/preview.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/main.js",
    "edge": "node --env-file-if-exists=.env edge/main.js",
    "test": "node --test test/*.test.js",
    "test:containers": "node scripts/test-containers.js",
    "test:crowdsec": "node scripts/test-crowdsec.js",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@mantine/core": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "lucide-react": "0.577.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "vite": "8.3.4"
  }
}
