# Deployment and Core connection. Domains and certificates are configured in the app.
# Set your actual private HTTPS management origin and VPS interface IPs in Komodo.
# Example private origin: https://your-host.your-tailnet.ts.net:8443
PROXY_ORIGIN=
PROXY_INGRESS_IPS=
PROXY_SITES_PATH=./sites
# Optional: enable compose.paths.yaml to put persistent data under this host directory.
PROXY_DATA_PATH=

# Credentials: use a random enrollment token of at least 32 characters.
PROXY_BOOTSTRAP_TOKEN=
PROXY_KOMODO_URL=
PROXY_KOMODO_KEY=
PROXY_KOMODO_SECRET=
PROXY_CLOUDFLARE_TOKEN=
# Optional overrides for individual domains added through the UI.
PROXY_CLOUDFLARE_TOKENS='{}'
