/var/lib/proxylogs/host/deployments.jsonl {
    su root root
    daily
    rotate 14
    maxsize 5M
    missingok
    notifempty
    compress
    create 0600 root root
}
/var/lib/proxylogs/audit/events.jsonl {
    su root root
    daily
    rotate 14
    maxsize 10M
    missingok
    notifempty
    compress
    create 0600
}
