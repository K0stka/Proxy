/var/log/proxy-deployments.jsonl {
    su root root
    daily
    rotate 14
    maxsize 5M
    missingok
    notifempty
    compress
    create 0600 root root
}
/var/log/proxy-management-audit/events.jsonl {
    su root root
    daily
    rotate 14
    maxsize 10M
    missingok
    notifempty
    compress
    create 0600
}
